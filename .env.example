# =============================================================================
# Contractor Website Starter — Environment Variables
# Copy this file to `.env.local` for local development, and set the same values
# in your Vercel Project Settings for production. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon Postgres) — REQUIRED in production
# -----------------------------------------------------------------------------
# Get this from the Neon dashboard: Project > Connection Details > "Pooled".
# The site still BUILDS and renders demo content when this is missing, but no
# data (leads, edited content) is persisted until a database is connected.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# AUTH — REQUIRED in production
# -----------------------------------------------------------------------------
# A long random string used to sign/verify admin session cookies.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# The canonical, public URL of the deployed site (no trailing slash).
# Used for canonical tags, sitemap URLs, Open Graph URLs, and secure cookies.
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# -----------------------------------------------------------------------------
# DEMO MODE — open, read-only admin panel — OPTIONAL
# -----------------------------------------------------------------------------
# "true"  = opens the admin panel to every visitor for VIEWING (no login) so
#           prospects can see the CMS they'd get. Editing is disabled and a
#           banner explains a real site is private/owner-only.
# Leave unset for a real customer site to keep the admin login-protected.
DEMO_OPEN_ADMIN=""

# -----------------------------------------------------------------------------
# EMAIL PROVIDER (Resend) — OPTIONAL
# -----------------------------------------------------------------------------
# Without these, leads are still saved and email drafts still work, but SENDING
# is disabled with an honest warning. The app never reports an email as "sent"
# unless the provider confirms success.
RESEND_API_KEY=""
# The "From" address must be on a domain you have verified in Resend.
EMAIL_FROM="Summit Ridge Roofing <notify@example.com>"
# Where new-lead notifications are delivered (usually the business owner).
LEAD_NOTIFICATION_EMAIL="owner@example.com"

# -----------------------------------------------------------------------------
# IMAGE STORAGE — OPTIONAL
# -----------------------------------------------------------------------------
# Leave BLANK (default): uploaded images are stored directly in your Postgres
# database and served from /api/media/[id] — no external store needed. Upload
# photos right in the admin and they go live on save.
# Set to "vercel-blob" or "cloudinary" ONLY if you'd rather offload image bytes
# to an object store/CDN (and provide the matching credentials below).
IMAGE_STORAGE_PROVIDER=""

# Vercel Blob (created automatically when you add Blob storage in Vercel):
BLOB_READ_WRITE_TOKEN=""

# Cloudinary (alternative to Vercel Blob):
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -----------------------------------------------------------------------------
# ANALYTICS & SEARCH CONSOLE — OPTIONAL (also editable in /admin/seo)
# -----------------------------------------------------------------------------
# These can be managed from the admin panel instead of here; env values act as
# defaults. Tracking scripts only load when a valid ID is present.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_CONTAINER_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""
